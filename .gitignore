node_modules/
hostkey_rsa
hostkey_*
dist/VeraDroidSSH*.zip
kpm/veradroid-ssh_*.kpkg
diagnostics/ssh/VeraDroid-SSH.zip
my-public-keys.txt
device_host_key*
